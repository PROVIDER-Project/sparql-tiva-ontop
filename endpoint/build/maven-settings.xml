<?xml version="1.0" encoding="UTF-8"?>
<!-- Global defaults; optional host user settings are merged by Maven. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>tiva-image-build</id>
      <repositories>
        <repository>
          <id>aksw-data-releases</id>
          <url>${env.TIVA_REPOSITORY_URL}</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
    <!-- Activated only when Make mounts the database's local deployment. -->
    <profile>
      <id>local-database</id>
      <activation>
        <property><name>env.TIVA_LOCAL_REPOSITORY</name><value>true</value></property>
      </activation>
      <repositories>
        <repository>
          <id>tiva-local-build</id>
          <url>file:///database-repository</url>
          <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
          <snapshots><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>tiva-image-build</activeProfile></activeProfiles>
</settings>
