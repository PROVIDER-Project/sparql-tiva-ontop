    ] .

<${NS_TIVA_R}mapping/units-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_unit" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}unit/{CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}scheme/unit> ]
    ] .

<${NS_TIVA_R}mapping/unit-multipliers-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_unit_multiplier" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}unit-multiplier/{UNIT_MULT}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "UNIT_MULT" ; rr:termType rr:Literal ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}scheme/unit-multiplier> ]
    ] .

<${NS_TIVA_R}mapping/cube-structure-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <${NS_TIVA_R}structure/fdva> ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:DataStructureDefinition ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/indicator> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/period> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/frequency> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/source-area> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/source-activity> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/demand-area> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/demand-activity> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/value> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/unit> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}component/multiplier> ]
    ] .

<${NS_TIVA_R}mapping/cube-structure-2> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <${NS_TIVA_R}component/indicator> ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:ComponentSpecification ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:dimension ;
        rr:objectMap [ rr:constant tivao:indicator ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:order ;
        rr:objectMap [ rr:constant 1 ]
    ] .

