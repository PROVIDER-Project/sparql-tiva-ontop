@prefix o: <${NS_GLOBAL_O}> .
@prefix r: <${NS_GLOBAL_R}> .
# R2RML mapping for the annual TiVA table in DuckDB.
# Observations use an indexed local name within a fixed-prefix IRI template.
# Code lists use small, unique tables built by load.sql.
# All column-based literals have explicit RDF datatypes.
# Static cube metadata is mapped from SELECT 1, so it is queryable too.
@prefix rr: <http://www.w3.org/ns/r2rml#> .

@prefix tivao: <${NS_TIVA_O}> .

@prefix tivar: <${NS_TIVA_R}> .

@prefix qb: <http://purl.org/linked-data/cube#> .

@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .

@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .

@prefix sdmx-measure: <http://purl.org/linked-data/sdmx/2009/measure#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix dct: <http://purl.org/dc/terms/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<${NS_TIVA_R}mapping/tiva-observations-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_observations" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}observation/{OBSERVATION_LOCAL_NAME}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:Observation ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:dataSet ;
        rr:objectMap [ rr:template "${NS_TIVA_R}dataset/{DATAFLOW}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tivao:indicator ;
        rr:objectMap [ rr:template "${NS_TIVA_R}indicator/{MEASURE}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-dimension:refPeriod ;
        rr:objectMap [ rr:column "YEAR" ; rr:termType rr:Literal ; rr:datatype xsd:gYear ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-dimension:freq ;
        rr:objectMap [ rr:template "${NS_TIVA_R}frequency/{FREQ}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tivao:valueAddedSourceArea ;
        rr:objectMap [ rr:template "${NS_TIVA_R}area/{VALUE_ADDED_SOURCE_AREA}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tivao:valueAddedSourceActivity ;
        rr:objectMap [ rr:template "${NS_TIVA_R}activity/{VALUE_ADDED_SOURCE_ACTIVITY}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tivao:finalDemandArea ;
        rr:objectMap [ rr:template "${NS_TIVA_R}area/{FINAL_DEMAND_AREA}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate tivao:finalDemandActivity ;
        rr:objectMap [ rr:template "${NS_TIVA_R}activity/{FINAL_DEMAND_ACTIVITY}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-measure:obsValue ;
        rr:objectMap [ rr:column "OBS_VALUE_LEXICAL" ; rr:termType rr:Literal ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-attribute:unitMeasure ;
        rr:objectMap [ rr:template "${NS_TIVA_R}unit/{UNIT_MEASURE}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-attribute:unitMult ;
        rr:objectMap [ rr:template "${NS_TIVA_R}unit-multiplier/{UNIT_MULT_CODE}" ; rr:termType rr:IRI ]
    ] .

<${NS_TIVA_R}mapping/tiva-datasets-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_dataset" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}dataset/{DATAFLOW}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:DataSet ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "DATAFLOW" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:structure ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}structure/fdva> ]
    ] .

<${NS_TIVA_R}mapping/areas-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_area" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}area/{CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}scheme/area> ]
    ] .

# Flattened area-to-country links. Country descriptions belong to a separate
# authoritative dataset; this map emits only the hasCountry relation.
<${NS_TIVA_R}mapping/area-countries-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_area_country" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}area/{AREA_CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate o:hasCountry ;
        rr:objectMap [ rr:template "${NS_GLOBAL_R}country/{COUNTRY_CODE}" ; rr:termType rr:IRI ]
    ] .

<${NS_TIVA_R}mapping/activities-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_activity" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}activity/{CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <${NS_TIVA_R}scheme/activity> ]
    ] .

<${NS_TIVA_R}mapping/indicators-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_indicator" ] ;
