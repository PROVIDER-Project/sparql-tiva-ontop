    ] .

<${NS_TIVA_R}mapping/frequencies-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_frequency" ] ;
    rr:subjectMap [ rr:template "${NS_TIVA_R}frequency/{CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
