<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.aksw.data.config</groupId>
    <artifactId>aksw-data-deployment</artifactId>
    <version>0.0.8</version>
    <relativePath />
  </parent>
  <groupId>org.aksw.data.tiva</groupId>
  <artifactId>tiva-fdva-2022-duckdb</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>
  <name>PROVIDER - OECD TiVA FDVA 2022 (2025 edition) preloaded DuckDB</name>
  <description>
    Zstandard-compressed DuckDB derived from OECD TiVA FDVA 2022 (2025 edition). Source coordinate:
org.aksw.data.thirdparty.org.oecd.tiva:FDVA_2019-2022:1. Produced by
https://github.com/PROVIDER-Project/sparql-tiva-ontop for its Ontop R2RML mappings.
RDF is not materialized. Transformations include typed ingestion, derived lookup
keys and lexical columns, deduplicated code lists, indexes and auditable country
links. Source values and dataset-specific area identities are retained.
Attribution: OECD (2025), Trade in Value Added (TiVA), Final Demand Value Added by Activity, 2022. Membership extraction: OECD (2023), Guide to TiVA Indicators, Tables A.1/A.2. Memberships are not verified against the 2025 edition. This is an adaptation of an original work by the OECD. The opinions expressed and arguments employed in this adaptation should not be reported as representing the official views of the OECD or of its Member countries. Retain OECD attribution and require downstream users to do the same.
  </description>
  <url>https://github.com/PROVIDER-Project/sparql-tiva-ontop</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>PROVIDER Project</name>
    <url>https://github.com/PROVIDER-Project</url>
  </organization>
  <developers>
    <developer>
      <name>Claus Stadler</name>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>OECD Terms and Conditions: Data</name>
      <url>https://www.oecd.org/en/about/terms-conditions.html</url>
      <distribution>repo</distribution>
      <comments>Source attribution and transformation notices must be retained. OECD data and the 2023 guide extraction retain their applicable OECD terms. No blanket CC BY licence is asserted. The data terms require carrying the acknowledgment requirement forward to sub-licensees; third-party exceptions remain applicable. See the accompanying provenance metadata.</comments>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/PROVIDER-Project/sparql-tiva-ontop.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/PROVIDER-Project/sparql-tiva-ontop.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/PROVIDER-Project/sparql-tiva-ontop</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/PROVIDER-Project/sparql-tiva-ontop/issues</url>
  </issueManagement>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <docker-maven-plugin.version>0.49.0</docker-maven-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <data.repository.url>https://maven.inf-ai.duckdns.org/releases</data.repository.url>
    <source.groupId>org.aksw.data.thirdparty.org.oecd.tiva</source.groupId>
    <duckdb.image>aksw/duckdb-shell:1.5.6</duckdb.image>
    <generator.image>datagen-${project.artifactId}:${project.version}</generator.image>
    <generator.timeout>7200000</generator.timeout>
    <compressor.base.image>debian:bookworm-slim</compressor.base.image>
    <compressor.image>compress-${project.artifactId}:${project.version}</compressor.image>
    <compressor.timeout>1800000</compressor.timeout>
    <zstd.level>6</zstd.level>
    <zstd.threads>2</zstd.threads>
    <docker.apiVersion>1.44</docker.apiVersion>
    <docker.showLogs>true</docker.showLogs>
    <input.directory>${project.build.directory}/inputs</input.directory>
    <database.filename>tiva.duckdb</database.filename>
    <output.filename>${database.filename}.zst</output.filename>
    <output.path>${project.build.directory}/${output.filename}</output.path>
    <source.artifactId>FDVA_2019-2022</source.artifactId>
    <source.version>1</source.version>
  </properties>
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
        <checksumPolicy>fail</checksumPolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>aksw-data-releases</id>
      <url>${data.repository.url}</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>maven.aksw.internal</id>
      <url>https://maven.aksw.org/repository/internal/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>maven.aksw.snapshots</id>
      <url>https://maven.aksw.org/repository/snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>maven.aksw.internal</id>
      <url>https://maven.aksw.org/repository/internal/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>maven.aksw.snapshots</id>
      <url>https://maven.aksw.org/repository/snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${maven-clean-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>${maven-install-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>${maven-deploy-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${build-helper-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-preloaded-database</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${output.path}</file>
                  <type>duckdb.zst</type>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>generate-data</id>
      <activation>
        <property>
          <name>skipGenerateData</name>
          <value>!true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <version>${docker-maven-plugin.version}</version>
            <configuration>
              <removeVolumes>true</removeVolumes>
              <images>
                <image>
                  <alias>tiva-generator</alias>
                  <name>${generator.image}</name>
                  <build>
                    <from>${duckdb.image}</from>
                    <assembly>
                      <targetDir>/</targetDir>
                      <exportTargetDir>false</exportTargetDir>
                      <inline>
                        <fileSets>
                          <fileSet>
                            <directory>${input.directory}</directory>
                            <outputDirectory>data</outputDirectory>
                            <includes>
                              <include>FDVA.csv.zst</include>
                            </includes>
                          </fileSet>
                        </fileSets>
                        <files>
                          <file>
                            <source>${project.basedir}/load.sql</source>
                            <outputDirectory>opt/ontop/input</outputDirectory>
                          </file>
                          <file>
                            <source>${project.basedir}/loader/load-duckdb.sh</source>
                            <outputDirectory>opt/loader</outputDirectory>
                          </file>
                          <file>
                            <source>${project.basedir}/tiva-area-mapping.csv</source>
                            <outputDirectory>opt/ontop/input</outputDirectory>
                          </file>
                        </files>
                      </inline>
                    </assembly>
                    <runCmds>
                      <run>mkdir -p /output</run>
                    </runCmds>
                    <volumes>
                      <volume>/output</volume>
                    </volumes>
                    <entryPoint>
                      <exec>
                        <arg>/bin/sh</arg>
                        <arg>/opt/loader/load-duckdb.sh</arg>
                      </exec>
                    </entryPoint>
                    <cmd>
                      <exec>
                        <arg>/output/${database.filename}</arg>
                        <arg>/opt/ontop/input/load.sql</arg>
                      </exec>
                    </cmd>
                  </build>
                  <run>
                    <wait>
                      <time>${generator.timeout}</time>
                      <exit>0</exit>
                    </wait>
                  </run>
                </image>
                <image>
                  <alias>tiva-compressor</alias>
                  <name>${compressor.image}</name>
                  <build>
                    <from>${compressor.base.image}</from>
                    <assembly>
                      <targetDir>/opt/compressor</targetDir>
                      <exportTargetDir>false</exportTargetDir>
                      <inline>
                        <files>
                          <file>
                            <source>${project.basedir}/loader/compress-duckdb.sh</source>
                          </file>
                        </files>
                      </inline>
                    </assembly>
                    <runCmds>
                      <run>apt-get update &amp;&amp; apt-get install -y --no-install-recommends zstd &amp;&amp; rm -rf /var/lib/apt/lists/*</run>
                    </runCmds>
                    <entryPoint>
                      <exec>
                        <arg>/bin/sh</arg>
                        <arg>/opt/compressor/compress-duckdb.sh</arg>
                      </exec>
                    </entryPoint>
                    <cmd>
                      <exec>
                        <arg>/output/${database.filename}</arg>
                        <arg>/output/${output.filename}</arg>
                        <arg>${zstd.level}</arg>
                        <arg>${zstd.threads}</arg>
                      </exec>
                    </cmd>
                  </build>
                  <run>
                    <volumes>
                      <from>
                        <image>${docker.container.tiva-generator.id}</image>
                      </from>
                    </volumes>
                    <wait>
                      <time>${compressor.timeout}</time>
                      <exit>0</exit>
                    </wait>
                  </run>
                  <copy>
                    <entries>
                      <entry>
                        <containerPath>/output/${output.filename}</containerPath>
                        <hostDirectory>${project.build.directory}</hostDirectory>
                      </entry>
                    </entries>
                  </copy>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>generate-preloaded-database</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>build</goal>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <filter>tiva-generator</filter>
                </configuration>
              </execution>
              <execution>
                <id>compress-preloaded-database</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>build</goal>
                  <goal>start</goal>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <filter>tiva-compressor</filter>
                </configuration>
              </execution>
              <execution>
                <id>remove-build-containers</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>resolve-inputs</id>
      <activation>
        <property>
          <name>skipGenerateData</name>
          <value>!true</value>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>${maven-dependency-plugin.version}</version>
            <executions>
              <execution>
                <id>resolve-input-snapshots</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <outputDirectory>${input.directory}</outputDirectory>
                  <artifactItems>
                    <artifactItem>
                      <groupId>${source.groupId}</groupId>
                      <artifactId>${source.artifactId}</artifactId>
                      <version>${source.version}</version>
                      <type>csv.zst</type>
                      <classifier>FDVA_2022</classifier>
                      <destFileName>FDVA.csv.zst</destFileName>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>