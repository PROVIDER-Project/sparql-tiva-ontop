        rr:objectMap [ rr:column "CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <https://example.org/tiva/scheme/activity> ]
    ] .

<https://example.org/tiva/mapping/indicators-1> a rr:TriplesMap ;
