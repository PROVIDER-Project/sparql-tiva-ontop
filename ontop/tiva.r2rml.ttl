        rr:objectMap [ rr:constant <https://example.org/tiva/scheme/unit> ]
    ] .

<https://example.org/tiva/mapping/unit-multipliers-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_unit_multiplier" ] ;
    rr:subjectMap [ rr:template "https://example.org/tiva/unit-multiplier/{UNIT_MULT}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "UNIT_MULT" ; rr:termType rr:Literal ; rr:datatype xsd:integer ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <https://example.org/tiva/scheme/unit-multiplier> ]
    ] .

<https://example.org/tiva/mapping/cube-structure-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/tiva/structure/fdva> ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:DataStructureDefinition ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/indicator> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/period> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/frequency> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/source-area> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/source-activity> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/demand-area> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/demand-activity> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/value> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/unit> ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:component ;
        rr:objectMap [ rr:constant <https://example.org/tiva/component/multiplier> ]
    ] .

<https://example.org/tiva/mapping/cube-structure-2> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/tiva/component/indicator> ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:ComponentSpecification ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:dimension ;
        rr:objectMap [ rr:constant ex:indicator ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:order ;
        rr:objectMap [ rr:constant 1 ]
    ] .

