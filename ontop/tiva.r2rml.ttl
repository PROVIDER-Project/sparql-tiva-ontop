<https://example.org/tiva/mapping/units-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_unit" ] ;
    rr:subjectMap [ rr:template "https://example.org/tiva/unit/{CODE}" ; rr:termType rr:IRI ] ;
