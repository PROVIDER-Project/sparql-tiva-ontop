    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:DimensionProperty ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdfs:range ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:codeList ;
        rr:objectMap [ rr:constant <https://example.org/tiva/scheme/indicator> ]
    ] .

