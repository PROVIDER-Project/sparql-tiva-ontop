# R2RML mapping for the annual TiVA table in DuckDB.
# Observations use an indexed local name within a fixed-prefix IRI template.
# Code lists use small, unique tables built by load.sql.
# All column-based literals have explicit RDF datatypes.
# Static cube metadata is mapped from SELECT 1, so it is queryable too.
@prefix rr: <http://www.w3.org/ns/r2rml#> .

@prefix ex: <https://example.org/tiva/vocab/> .

@prefix res: <https://example.org/tiva/> .

@prefix qb: <http://purl.org/linked-data/cube#> .

@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .

@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .

@prefix sdmx-measure: <http://purl.org/linked-data/sdmx/2009/measure#> .

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix dct: <http://purl.org/dc/terms/> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/tiva/mapping/tiva-observations-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_observations" ] ;
    rr:subjectMap [ rr:template "https://example.org/tiva/observation/{OBSERVATION_LOCAL_NAME}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:Observation ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:dataSet ;
        rr:objectMap [ rr:template "https://example.org/tiva/dataset/{DATAFLOW}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:indicator ;
        rr:objectMap [ rr:template "https://example.org/tiva/indicator/{MEASURE}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-dimension:refPeriod ;
        rr:objectMap [ rr:column "YEAR" ; rr:termType rr:Literal ; rr:datatype xsd:gYear ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-dimension:freq ;
        rr:objectMap [ rr:template "https://example.org/tiva/frequency/{FREQ}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:valueAddedSourceArea ;
        rr:objectMap [ rr:template "https://example.org/tiva/area/{VALUE_ADDED_SOURCE_AREA}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:valueAddedSourceActivity ;
        rr:objectMap [ rr:template "https://example.org/tiva/activity/{VALUE_ADDED_SOURCE_ACTIVITY}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:finalDemandArea ;
        rr:objectMap [ rr:template "https://example.org/tiva/area/{FINAL_DEMAND_AREA}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:finalDemandActivity ;
        rr:objectMap [ rr:template "https://example.org/tiva/activity/{FINAL_DEMAND_ACTIVITY}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-measure:obsValue ;
        rr:objectMap [ rr:column "OBS_VALUE_LEXICAL" ; rr:termType rr:Literal ; rr:datatype xsd:double ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-attribute:unitMeasure ;
        rr:objectMap [ rr:template "https://example.org/tiva/unit/{UNIT_MEASURE}" ; rr:termType rr:IRI ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate sdmx-attribute:unitMult ;
        rr:objectMap [ rr:template "https://example.org/tiva/unit-multiplier/{UNIT_MULT_CODE}" ; rr:termType rr:IRI ]
    ] .

<https://example.org/tiva/mapping/tiva-datasets-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_dataset" ] ;
    rr:subjectMap [ rr:template "https://example.org/tiva/dataset/{DATAFLOW}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant qb:DataSet ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate dct:identifier ;
        rr:objectMap [ rr:column "DATAFLOW" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate qb:structure ;
        rr:objectMap [ rr:constant <https://example.org/tiva/structure/fdva> ]
    ] .

<https://example.org/tiva/mapping/areas-1> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "tiva_area" ] ;
    rr:subjectMap [ rr:template "https://example.org/tiva/area/{CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [ rr:constant skos:Concept ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:notation ;
        rr:objectMap [ rr:column "CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate skos:inScheme ;
        rr:objectMap [ rr:constant <https://example.org/tiva/scheme/area> ]
    ] .

<https://example.org/tiva/mapping/activities-1> a rr:TriplesMap ;
